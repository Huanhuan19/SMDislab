<UserControl x:Class="SMDisLabSys.Pages.WL.AG.Views.AnPeiLi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SMDisLabSys.Pages.WL.AG.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:convert="clr-namespace:SMDisLabSys.UIServer.DataConvert"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1800">
    <UserControl.Resources>
        <convert:VisibleToHidden x:Key="visibleToHidden"></convert:VisibleToHidden>
    </UserControl.Resources>
    <Grid Background="#f8fCf8">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"></RowDefinition>
            <RowDefinition Height="110"></RowDefinition>
            <RowDefinition Height="80"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="10"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding ChartTitle}" Style="{StaticResource TextBlock_Default}" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            <lvc:CartesianChart x:Name="Chart" Grid.Row="1" Margin="10,5,5,0" Hoverable="False" DisableAnimations="True" DataTooltip="{x:Null}" Foreground="White"
            Series="{Binding SeriesDic}" Zoom="X" Pan="Xy" Background="#FFf7f1" LegendLocation="None">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis LabelFormatter="{Binding XFormatter}" MinValue="{Binding Min}" MaxValue="{Binding Max}"
                          DisableAnimations="True" Title="" FontSize="20"
                          Foreground="{DynamicResource SolidColorBrush_8}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Visibility="Visible" Stroke="#aFB751" StrokeThickness="1" StrokeDashArray="3,10"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis LabelFormatter="{Binding YFormatter}" MinValue="{Binding MinY}" MaxValue="{Binding MaxY}" DisableAnimations="True" Title="{Binding YLineTitle}" FontSize="20"
                          Foreground="{DynamicResource SolidColorBrush_8}">
                        <lvc:Axis.Separator>
                            <lvc:Separator Visibility="Visible" Step="{Binding YStep}" Stroke="#aFB751" StrokeThickness="1" StrokeDashArray="3,10"/>
                        </lvc:Axis.Separator>
                    </lvc:Axis>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource StackPanel_Center}" Margin="10,20,10,10" Height="80">
            <TextBlock Text="F" FontSize="40" Style="{StaticResource TextBlock_Default}" Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            <TextBox Style="{StaticResource TextBox_DefaultRadius}" Margin="5,0,5,0" Width="160" Text="{Binding F, StringFormat={}{0:F3}N}" FontSize="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource StackPanel_Center}" Margin="10,20,10,10" Height="80">
            <TextBlock Text="B" FontSize="40" Style="{StaticResource TextBlock_Default}" Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            <TextBox Style="{StaticResource TextBox_DefaultRadius}" Margin="5,0,5,0" Width="160" Text="{Binding B, StringFormat={}{0:F3}T}" FontSize="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="3" Style="{StaticResource StackPanel_Center}" Margin="10,20,10,10" Height="80">
            <TextBlock Text="I" FontSize="40" Style="{StaticResource TextBlock_Default}" Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            <TextBox Style="{StaticResource TextBox_DefaultRadius}" Margin="5,0,5,0" Width="160" Text="{Binding I, StringFormat={}{0:F3}A}" FontSize="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="4" Style="{StaticResource StackPanel_Center}" Margin="10,20,10,10" Height="80">
            <TextBlock Text="L" FontSize="40" Style="{StaticResource TextBlock_Default}" Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            <TextBox Style="{StaticResource TextBox_DefaultRadius}" Margin="5,0,5,0" Width="160" Text="{Binding L, StringFormat={}{0:F3}m}" FontSize="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" IsReadOnly="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="5" Style="{StaticResource StackPanel_Center}" Margin="10,20,10,10" Height="80">
            <TextBlock Text="θ" FontSize="40" Style="{StaticResource TextBlock_Default}" Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
            <TextBox Style="{StaticResource TextBox_DefaultRadius}" Margin="5,0,5,0" Width="160" Text="{Binding Theta, StringFormat={}{0:F1}°}" FontSize="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" IsReadOnly="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Style="{StaticResource StackPanel_Center}" Margin="0,0,0,0" Height="60">
            <Button Style="{StaticResource BtnInfoStyle2}" Content="← 往近" Width="140" Margin="10,0,0,0" VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding PressCommand}" CommandParameter="Near"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Near"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostMouseCapture">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Near"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Style="{StaticResource BtnInfoStyle2}" Content="→ 往远" Width="140" Margin="10,0,0,0" VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding PressCommand}" CommandParameter="Far"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Far"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostMouseCapture">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Far"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Style="{StaticResource BtnInfoStyle2}" Content="↻ 旋转" Width="140" Margin="10,0,0,0" VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding PressCommand}" CommandParameter="Rotate"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Rotate"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostMouseCapture">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Rotate"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Style="{StaticResource BtnInfoStyle2}" Content="复位" Width="150" Margin="10,0,0,0" VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding PressCommand}" CommandParameter="Cycle"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Cycle"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostMouseCapture">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="Cycle"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Style="{StaticResource BtnInfoStyle2}" Content="+ 电流加大" Width="160" Margin="10,0,0,0" VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding PressCommand}" CommandParameter="CurrentUp"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="CurrentUp"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostMouseCapture">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="CurrentUp"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Style="{StaticResource BtnInfoStyle2}" Content="− 电流减小" Width="160" Margin="10,0,0,0" VerticalAlignment="Center">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding PressCommand}" CommandParameter="CurrentDown"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="CurrentDown"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="LostMouseCapture">
                        <i:InvokeCommandAction Command="{Binding ReleaseCommand}" CommandParameter="CurrentDown"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </StackPanel>
        <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding ConnectItem}" FontSize="20" Style="{StaticResource TextBlock_Default}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"></TextBlock>
    </Grid>
</UserControl>
